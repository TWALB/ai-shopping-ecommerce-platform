{
  "name": "数码导购检索评测集",
  "version": "1.0",
  "corpus": "测试商品数据.sql（8 件商品：1 iPhone 17 Pro / 2 华为 Mate 70 Pro / 3 小米 15 / 4 Redmi Note 14 / 5 MacBook Air 13 / 6 联想拯救者 Y7000P / 7 iPad Air 11 / 8 索尼 WH-1000XM6）",
  "description": "每条 query 标注五项：标准意图 intent、标准槽位 slots、可接受商品集合 expected、样本类型 kind、备注 note。kind=retrieval 计入命中率类指标；kind=abstain 表示语料中确实无满足条件商品，正确行为是返回空；kind=open 为无约束的开放式推荐，只计意图/槽位，不计检索命中；kind=chat 为域外或闲聊，只计意图。",
  "intentTaxonomy": {
    "priority": "compare > find_product > recommend > chat",
    "compare": "同时对两个及以上具体对象做比较（含关键词：对比/比较/哪个好/怎么选/区别/vs/哪个适合）",
    "find_product": "用户给出了可落到商品字段的检索条件（品类/预算/品牌/关注点任一项），目标是找出符合条件的商品，含『XX推荐』这类带硬约束的表述",
    "recommend": "用户要的是选购建议或主观评价，缺少硬约束（如『怎么样』『值得买吗』『给爸妈买』）",
    "chat": "与选购无关（问候、天气、订单物流等域外问题）",
    "note": "四类边界存在主观性，故另行统计『检索类/非检索类』二分类准确率作为不受标签细则影响的口径"
  },
  "metricDefs": {
    "intentAcc": "意图识别准确率（4 类严格匹配）= 预测意图与标准意图一致的样本数 / 有标准意图的样本数",
    "intentBinaryAcc": "检索/非检索二分类准确率 = (预测是否属于 find_product|recommend|compare) 与标注一致的样本数 / 样本数",
    "categoryAcc": "品类槽位准确率 = 预测 category 与标注 category 字符串一致的样本数 / category 非空样本数",
    "budgetAcc": "预算槽位准确率 = |预测预算-标注预算| <= 标注预算*10% 的样本数 / 标注预算>0 的样本数",
    "hitAt5": "Top5 命中率 = 前 5 条结果中至少命中原可接受集合任一件的样本数 / retrieval 样本数（小语料下易饱和，仅作参考）",
    "recallAt5": "Top5 召回率 = 各样本 |Top5 ∩ 可接受集合| / |可接受集合| 的均值",
    "precisionAt5": "Top5 精度 = 返回商品中属于可接受集合的条数 / 返回总条数（衡量是否夹带无关商品）",
    "mrr": "平均倒数排名 = 第一条相关结果排名的倒数均值（未命中记 0）",
    "budgetViolation": "预算越界率 = 返回商品价格超过标注预算 1.2 倍的条数 / 返回条数（仅统计标注预算>0 且 kind=retrieval 的样本）",
    "crossCategoryMissRate": "跨品类错配率 = 返回商品所属品类与标注品类不符的条数 / 返回条数（问手机却推耳机即计入）",
    "abstainAcc": "弃答准确率 = 无满足条件商品时正确返回空的样本数 / abstain 样本数",
    "avgLatencyMs": "单次检索平均耗时（毫秒）"
  },
  "items": [
