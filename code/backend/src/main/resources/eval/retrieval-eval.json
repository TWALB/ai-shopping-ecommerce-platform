    { "id": "Q02", "query": "3000元左右的手机", "kind": "retrieval", "intent": "find_product", "slots": { "category": "手机", "budget": 3000, "keyword": "", "brand": "" }, "expected": [3], "note": "小米 15 售价 2999" },
